{
  "id": "gcp-web",
  "version": "v0.1",
  "cloud": "gcp",
  "lifecycle": "DRAFT",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "deployment_id": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "클라우드 자원 이름 접두사",
        "pattern": "^[a-z][a-z0-9-]{2,19}$",
        "description": "Cloud-native deployment name. Immutable after draft creation."
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "environment": {
            "type": "string",
            "enum": [
              "poc",
              "dev"
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "cost_center": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "workload": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "migration_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential"
            ]
          },
          "expires_on": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "project",
          "environment",
          "owner",
          "cost_center",
          "workload",
          "migration_id",
          "data_class",
          "expires_on"
        ],
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "소유권·비용 추적 정보"
      },
      "region": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "리전"
      },
      "zone": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "가용 영역"
      },
      "project_id": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "GCP 프로젝트"
      },
      "bucket_name": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "파일 저장소 이름",
        "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
      },
      "database_name": {
        "type": "string",
        "x-ui": {
          "group": "platform",
          "editable_by": [
            "editor"
          ],
          "ai_recommendable": false
        },
        "title": "초기 DB 이름",
        "pattern": "^[a-z][a-z0-9]{0,30}$"
      },
      "web_ingress_cidrs": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "IPv4 CIDR; host bits, overlap and subnet containment require semantic validation."
        },
        "minItems": 1,
        "uniqueItems": true,
        "x-ui": {
          "group": "network-policy",
          "editable_by": [
            "infra_admin"
          ],
          "ai_recommendable": false
        }
      },
      "web_ports": {
        "type": "array",
        "items": {
          "type": "integer",
          "enum": [
            80,
            443,
            8080
          ]
        },
        "minItems": 1,
        "uniqueItems": true,
        "x-ui": {
          "group": "network-policy",
          "editable_by": [
            "infra_admin"
          ],
          "ai_recommendable": false
        }
      },
      "admin_cidrs": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "IPv4 CIDR; host bits, overlap and subnet containment require semantic validation."
        },
        "uniqueItems": true,
        "description": "/24~32 only. Empty by default.",
        "x-ui": {
          "group": "network-policy",
          "editable_by": [
            "infra_admin"
          ],
          "ai_recommendable": false
        }
      },
      "deletion_protection": {
        "type": "boolean",
        "x-ui": {
          "group": "network-policy",
          "editable_by": [
            "infra_admin"
          ],
          "ai_recommendable": false
        },
        "title": "DB 삭제 보호"
      },
      "network": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subnet_cidr": {
            "type": "string"
          },
          "service_range_address": {
            "type": "string"
          },
          "service_range_prefix": {
            "type": "integer",
            "minimum": 16,
            "maximum": 20
          }
        },
        "required": [
          "subnet_cidr",
          "service_range_address",
          "service_range_prefix"
        ],
        "x-ui": {
          "group": "network-policy",
          "editable_by": [
            "infra_admin"
          ],
          "ai_recommendable": false
        },
        "title": "네트워크 구성"
      },
      "sizing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "compute_machine_type": {
            "type": "string",
            "enum": [
              "e2-small",
              "e2-medium",
              "e2-standard-2"
            ],
            "title": "앱 서버 사양",
            "default": "e2-small",
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "compute_disk_gib": {
            "type": "integer",
            "minimum": 20,
            "maximum": 200,
            "title": "앱 디스크 용량 (GiB)",
            "default": 30,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "db_tier": {
            "type": "string",
            "enum": [
              "db-custom-1-3840",
              "db-custom-2-7680",
              "db-custom-4-15360"
            ],
            "title": "DB 사양",
            "default": "db-custom-1-3840",
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "db_storage_gib": {
            "type": "integer",
            "minimum": 20,
            "maximum": 200,
            "title": "DB 초기 용량 (GiB)",
            "default": 20,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "db_max_storage_gib": {
            "type": "integer",
            "minimum": 22,
            "maximum": 500,
            "title": "DB 자동 확장 상한 (GiB)",
            "default": 100,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "db_high_availability": {
            "type": "boolean",
            "title": "DB 고가용성",
            "default": false,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "cache_memory_gib": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "title": "캐시 메모리 (GiB)",
            "default": 1,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          },
          "cache_high_availability": {
            "type": "boolean",
            "title": "캐시 고가용성",
            "default": false,
            "x-ui": {
              "group": "sizing",
              "editable_by": [
                "editor"
              ],
              "ai_recommendable": true
            }
          }
        },
        "required": [
          "compute_machine_type",
          "compute_disk_gib",
          "db_tier",
          "db_storage_gib",
          "db_max_storage_gib",
          "db_high_availability",
          "cache_memory_gib",
          "cache_high_availability"
        ]
      }
    },
    "required": [
      "deployment_id",
      "metadata",
      "region",
      "zone",
      "project_id",
      "bucket_name",
      "database_name",
      "web_ingress_cidrs",
      "web_ports",
      "admin_cidrs",
      "deletion_protection",
      "network",
      "sizing"
    ]
  },
  "default_inputs": {
    "deployment_id": "fox-gcp-poc01",
    "metadata": {
      "project": "foxtrot",
      "environment": "poc",
      "owner": "platform-team",
      "cost_center": "hackathon",
      "workload": "web",
      "migration_id": "mig-001",
      "data_class": "internal",
      "expires_on": "2026-12-01"
    },
    "region": "asia-northeast3",
    "zone": "asia-northeast3-a",
    "project_id": "replace-with-project-id",
    "bucket_name": "replace-with-globally-unique-gcp-bucket",
    "database_name": "app",
    "web_ingress_cidrs": [
      "0.0.0.0/0"
    ],
    "web_ports": [
      80,
      443
    ],
    "admin_cidrs": [],
    "deletion_protection": true,
    "network": {
      "subnet_cidr": "10.30.0.0/24",
      "service_range_address": "10.31.0.0",
      "service_range_prefix": 16
    },
    "sizing": {
      "compute_machine_type": "e2-small",
      "compute_disk_gib": 30,
      "db_tier": "db-custom-1-3840",
      "db_storage_gib": 20,
      "db_max_storage_gib": 100,
      "db_high_availability": false,
      "cache_memory_gib": 1,
      "cache_high_availability": false
    }
  },
  "image_profiles": [],
  "fixed_rules": [
    "database-private-only",
    "cache-tls-and-auth",
    "storage-public-access-blocked"
  ],
  "limitations": [
    "Template and image profile need explicit approval before plan.",
    "Examples contain account/project/bucket placeholders.",
    "Container runtime is not installed by current Terraform modules."
  ]
}
