      "imagePrefixes": [
        "ghcr.io/softbank-2026-hackathon-foxtrot/"
      ],
      "environment": {
        "REDIS_URL": "redis://redis-proxy.internal:6379",
        "OBJECT_MIGRATION_SERVER": "http://object-migration.internal:8080"
      },
      "apiEnvironment": {
        "WORKLOAD_ACTOR": "chiikawa-onprem-api"
      },
      "workerEnvironment": {
        "WORKLOAD_ACTOR": "chiikawa-onprem-worker"
      },
      "readinessDeadlineSeconds": 180
    }
  }
