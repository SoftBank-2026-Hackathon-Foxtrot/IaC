  "nodes": {
    "home-pc": {
      "orgs": [
        "chiikawa"
      ],
      "dockerHost": "ssh://deploy@100.64.1.2:22",
      "sshKeyFile": "/run/foxtrot/onprem-ssh-key",
      "sshHostKey": "ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_KEY",
      "runtimeRoot": "/home/deploy/foxtrot/apps",
      "network": "registered-data_default",
      "bindAddress": "100.64.1.2",
